# ==========================================
# Touralink Environment Variables
# ==========================================

# Mapbox Access Token (Maps, Autocomplete, Distance Matrix, 3D Route Explorer)
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Firebase Configuration (Cloud Firestore & Authentication)
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps (Web)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Groq AI Configuration (Free - https://console.groq.com/keys)
VITE_GROQ_API_KEY=your_groq_api_key_here

